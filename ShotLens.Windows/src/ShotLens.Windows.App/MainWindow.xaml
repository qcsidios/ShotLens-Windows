<Window x:Class="ShotLens.Windows.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ShotLens"
        Width="520"
        Height="500"
        MinWidth="460"
        MinHeight="420"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="ShotLens for Windows" FontSize="24" FontWeight="SemiBold"/>
            <TextBlock x:Name="VersionTextBlock" Foreground="#666" Margin="0,4,0,0"/>
            <TextBlock Text="快捷键：Ctrl + Alt + T。截图、OCR 在本机完成，识别出的文字会发送给你配置的翻译 API。"
                       TextWrapping="Wrap"
                       Foreground="#444"
                       Margin="0,12,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="1">
            <TextBlock Text="API 地址"/>
            <TextBox x:Name="EndpointTextBox"/>

            <TextBlock Text="API Key"/>
            <PasswordBox x:Name="ApiKeyPasswordBox"/>

            <TextBlock Text="模型"/>
            <TextBox x:Name="ModelTextBox"/>

            <CheckBox x:Name="UseDefaultCheckBox"
                      Content="留空时使用 ShotLens 默认限免配置"
                      Margin="0,0,0,12"/>

            <TextBlock x:Name="StatusTextBlock"
                       TextWrapping="Wrap"
                       Foreground="#555"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="测试 API" Click="TestApiButton_Click"/>
            <Button Content="检查更新" Click="CheckUpdateButton_Click"/>
            <Button Content="开始截图" Click="StartCaptureButton_Click"/>
            <Button Content="保存" Click="SaveButton_Click"/>
        </StackPanel>
    </Grid>
</Window>

<Window x:Class="ShotLens.Windows.App.ResultOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ShotLens 翻译结果"
        WindowStyle="ToolWindow"
        ResizeMode="CanResize"
        Topmost="True"
        Background="#111">
    <DockPanel>
        <Border DockPanel.Dock="Top"
                Background="#EE111111"
                Padding="8">
            <StackPanel Orientation="Horizontal">
                <Button Content="复制译文" Click="CopyTextButton_Click"/>
                <Button Content="关闭" Click="CloseButton_Click"/>
                <TextBlock x:Name="SummaryTextBlock"
                           VerticalAlignment="Center"
                           Foreground="White"
                           Margin="8,0,0,0"/>
            </StackPanel>
        </Border>
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <Grid>
                <Image x:Name="ScreenshotImage" Stretch="None"/>
                <Canvas x:Name="TranslationCanvas" IsHitTestVisible="False"/>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</Window>

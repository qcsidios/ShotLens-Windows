<Application x:Class="ShotLens.Windows.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="ShotLensAccentBrush" Color="#2563EB"/>
        <SolidColorBrush x:Key="ShotLensCardBrush" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="ShotLensBorderBrush" Color="#D0D7E2"/>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="MinWidth" Value="88"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,4,0,12"/>
            <Setter Property="Padding" Value="8,5"/>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Margin" Value="0,4,0,12"/>
            <Setter Property="Padding" Value="8,5"/>
        </Style>
    </Application.Resources>
</Application>

<Window x:Class="ShotLens.Windows.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ShotLens"
        Width="520"
        Height="760"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <Grid Background="#F7F3EA" Margin="28">
        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <Image Source="Resources/ShotLens.png" Width="44" Height="44" Margin="0,0,14,0"/>
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="ShotLens" FontSize="26" FontWeight="SemiBold" Foreground="#12372A"/>
                        <Border Background="#DAE7D8" CornerRadius="8" Margin="10,4,0,4" Padding="8,2">
                            <TextBlock Text="基础版" Foreground="#24513C" FontSize="12"/>
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="VersionText" Foreground="#64748B" Margin="0,3,0,0"/>
                </StackPanel>
            </StackPanel>

            <Border Background="#F7F3EA"
                    BorderBrush="#DDD6C8"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="18"
                    Margin="0,24,0,0">
                <StackPanel>
                    <TextBlock Text="截图翻译" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock x:Name="WorkflowStatusText"
                               Text="点击按钮后框选屏幕区域，ShotLens 会识别并翻译其中的文字。"
                               Foreground="#475569"
                               TextWrapping="Wrap"
                               Margin="0,10,0,16"/>
                    <Button x:Name="CaptureButton"
                            Content="开始截图翻译"
                            Padding="18,8"
                            HorizontalAlignment="Right"
                            Click="CaptureButton_Click"/>
                </StackPanel>
            </Border>

            <Border Background="#FFFCF5"
                    BorderBrush="#DDD6C8"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="18"
                    Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="API 设置" FontSize="16" FontWeight="SemiBold" Foreground="#12372A"/>
                    <TextBlock Text="默认限免使用硅基流动；自定义 Key 只会明文保存在本机设置文件。"
                               Foreground="#667085"
                               TextWrapping="Wrap"
                               Margin="0,8,0,12"/>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="DefaultApiRadio"
                                     Content="默认限免"
                                     GroupName="ApiMode"
                                     Margin="0,0,18,0"/>
                        <RadioButton x:Name="CustomApiRadio"
                                     Content="自定义 Key"
                                     GroupName="ApiMode"
                                     Margin="0,0,18,0"/>
                        <RadioButton x:Name="DisabledApiRadio"
                                     Content="禁用翻译"
                                     GroupName="ApiMode"/>
                    </StackPanel>
                    <PasswordBox x:Name="UserApiKeyBox"
                                 Margin="0,12,0,0"
                                 Padding="10,7"/>
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="ApiStatusText"
                                   Foreground="#667085"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap"/>
                        <Button Grid.Column="1"
                                Content="保存 API"
                                Padding="14,7"
                                Click="SaveApiButton_Click"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Background="{StaticResource CardBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="18"
                    Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="应用内升级" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock x:Name="StatusText"
                               Text="准备检查测试版本。"
                               Foreground="#475569"
                               TextWrapping="Wrap"
                               Margin="0,10,0,16"/>
                    <ProgressBar x:Name="DownloadProgress"
                                 Height="6"
                                 Minimum="0"
                                 Maximum="1"
                                 Visibility="Collapsed"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                        <Button x:Name="CheckButton"
                                Content="检测新版本"
                                Padding="14,7"
                                Click="CheckButton_Click"/>
                        <Button x:Name="InstallButton"
                                Content="升级"
                                Padding="18,7"
                                Margin="10,0,0,0"
                                Visibility="Collapsed"
                                Click="InstallButton_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Window>

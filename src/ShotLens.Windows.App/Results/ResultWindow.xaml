<Window x:Class="ShotLens.Windows.App.Results.ResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ShotLens 翻译结果"
        Width="640"
        Height="520"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        Background="#F7F3EA">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="翻译结果"
                       FontSize="24"
                       FontWeight="SemiBold"
                       Foreground="#12372A"/>
            <TextBlock x:Name="StatusText"
                       Margin="0,6,0,0"
                       Foreground="#667085"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,20,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Background="#FFFCF5"
                    BorderBrush="#DDD6C8"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="14">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="原文"
                               FontWeight="SemiBold"
                               Foreground="#12372A"
                               Margin="0,0,0,8"/>
                    <TextBox x:Name="OriginalText"
                             BorderThickness="0"
                             Background="Transparent"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             IsReadOnly="True"
                             VerticalScrollBarVisibility="Auto"/>
                </DockPanel>
            </Border>

            <Border Grid.Column="2"
                    Background="White"
                    BorderBrush="#C9D8CC"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="14">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="译文"
                               FontWeight="SemiBold"
                               Foreground="#12372A"
                               Margin="0,0,0,8"/>
                    <TextBox x:Name="TranslatedText"
                             BorderThickness="0"
                             Background="Transparent"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             IsReadOnly="True"
                             VerticalScrollBarVisibility="Auto"/>
                </DockPanel>
            </Border>
        </Grid>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="复制译文"
                    Padding="18,8"
                    Click="CopyButton_Click"/>
            <Button Content="关闭"
                    Padding="18,8"
                    Margin="10,0,0,0"
                    Click="CloseButton_Click"/>
        </StackPanel>
    </Grid>
</Window>

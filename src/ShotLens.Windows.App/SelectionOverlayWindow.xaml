<Window x:Class="ShotLens.Windows.App.SelectionOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        AllowsTransparency="False"
        Cursor="Cross"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">
    <Grid>
        <Image x:Name="ScreenshotImage" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality"/>
        <Canvas x:Name="OverlayCanvas" Background="Transparent">
            <Rectangle x:Name="SelectionRectangle"
                       Stroke="#33A1FF"
                       StrokeThickness="2"
                       Fill="#1833A1FF"
                       Visibility="Collapsed"/>
        </Canvas>
        <Border HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,24,0,0"
                Padding="12,8"
                Background="#CC111111"
                CornerRadius="8">
            <TextBlock Foreground="White" Text="拖拽选择翻译区域，Esc 取消"/>
        </Border>
    </Grid>
</Window>

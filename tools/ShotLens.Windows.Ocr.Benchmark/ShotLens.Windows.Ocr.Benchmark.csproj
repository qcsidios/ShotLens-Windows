<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <UseWPF Condition="'$(OS)' == 'Windows_NT'">true</UseWPF>
  </PropertyGroup>
  <ItemGroup Condition="'$(OS)' != 'Windows_NT'">
    <Compile Remove="Windows/**/*.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(OS)' == 'Windows_NT'">
    <Compile Remove="NonWindows/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/ShotLens.Windows.Core/ShotLens.Windows.Core.csproj" />
    <ProjectReference Include="../../src/ShotLens.Windows.Ocr.Worker/ShotLens.Windows.Ocr.Worker.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="SkiaSharp.NativeAssets.macOS"
                      PrivateAssets="all" />
  </ItemGroup>
</Project>
